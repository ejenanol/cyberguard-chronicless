{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(hint|resolve-username|soc)",
      "dest": "/api/$1.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "status": 404
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feat/phishing-soc-investigation": false,
      "feat/soc-lab-workspace": false,
      "feat/chapter-one-investigation": false
    }
  }
}
